# Local PostgreSQL default. Replace configured secrets before an exposed deployment.
POSTGRES_PASSWORD=valsec_local_change_me
SECRET_KEY=change_me_to_a_long_random_string
VALSEC_ENV=development

# Ollama remains local to the deployment. Docker reaches a host Ollama through
# host.docker.internal; native backend runs may use http://localhost:11434.
OLLAMA_URL=http://host.docker.internal:11434
INFERENCE_TIMEOUT_MULTIPLIER=1.5
# Sizes the DB pool and sets Celery worker concurrency.
MAX_CONCURRENT_AUDITS=5
# Opt-in credential storage. Use a distinct random key of at least 32
# characters; never reuse SECRET_KEY.
ENABLE_CREDENTIAL_VAULT=false
CREDENTIAL_VAULT_KEY=
DISCOVERY_MAX_DEPTH=3
DISCOVERY_MAX_DEVICES=25
OLLAMA_MAPPING_BATCH_SIZE=24
OLLAMA_MAPPING_MAX_CANDIDATES=96

# Optional multi-user deployment
# REQUIRE_AUTH=false
# APP_URL=http://localhost:3000
# EMAIL_BACKEND=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=Valsec <no-reply@your-domain>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
